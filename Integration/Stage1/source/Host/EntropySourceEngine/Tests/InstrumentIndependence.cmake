
file(MAKE_DIRECTORY "${OUT}")
foreach(name SourceDomainStream CinemaSourceDomainStream SourceFifo192 SourceDomainRuntime)
 foreach(ext h cpp)
  file(READ "${CORE}/${name}.${ext}" text)
  if(name STREQUAL "SourceFifo192" AND ext STREQUAL "h")
   string(PREPEND text "#include \"AuditHooks.h\"\n")
   string(REPLACE "else entered=true;" "else { entered=true; if(auditFifoOperationHook) auditFifoOperationHook(&owner); }" text "${text}")
  elseif(name STREQUAL "SourceFifo192" AND ext STREQUAL "cpp")
   string(REPLACE "        resetting_.store(false,std::memory_order_release);\n        return false;" "        if(auditResetRefusedHook) auditResetRefusedHook(this);\n        resetting_.store(false,std::memory_order_release);\n        return false;" text "${text}")
  elseif((name STREQUAL "SourceDomainStream" OR name STREQUAL "CinemaSourceDomainStream") AND ext STREQUAL "h")
   string(REPLACE "private:" "public:\n SourceFifo192& auditCaptureFifo() noexcept { return captureFifo_; }\nprivate:" text "${text}")
  elseif((name STREQUAL "SourceDomainStream" OR name STREQUAL "CinemaSourceDomainStream") AND ext STREQUAL "cpp")
   string(PREPEND text "#include \"AuditHooks.h\"\n")
   if(name STREQUAL "SourceDomainStream")
    string(REPLACE "        SourceStreamDescriptor descriptor{" "        auditBoundary(0,0,pointers.data(),b.frame_count);\n        SourceStreamDescriptor descriptor{" text "${text}")
   else()
    string(REPLACE "        SourceStreamDescriptor descriptor{" "        auditBoundary(0,2,constPointers.data(),block.frame_count);\n        SourceStreamDescriptor descriptor{" text "${text}")
   endif()
  elseif(name STREQUAL "SourceDomainRuntime" AND ext STREQUAL "h")
   string(REPLACE "private:" "private:\n friend struct SourceDomainRaceProbe;" text "${text}")
  elseif(name STREQUAL "SourceDomainRuntime" AND ext STREQUAL "cpp")
   string(PREPEND text "extern void cinemaReadBarrier();\n")
   string(REPLACE "    const bool ok = cinema_.pop1024" "    cinemaReadBarrier();\n    const bool ok = cinema_.pop1024" text "${text}")
  endif()
  file(WRITE "${OUT}/${name}.${ext}" "${text}")
 endforeach()
endforeach()
file(READ "${APP}/Core/SourceController.cpp" text)
string(PREPEND text "extern void engineCommandBarrier();\n")
string(REPLACE "    else if (cmd.type == SourceCommand::Engine)\n    {" "    else if (cmd.type == SourceCommand::Engine)\n    {\n        engineCommandBarrier();" text "${text}")
file(WRITE "${OUT}/SourceController.cpp" "${text}")
