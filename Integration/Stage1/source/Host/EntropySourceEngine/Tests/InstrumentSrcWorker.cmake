# Generate a test-only translation unit; fail on unexpected production anchors.
file(READ "${SOURCE}" original)
string(FIND "${original}" "void SourceDomainStream::srcWorker() noexcept {" split)
if(split LESS 0)
  message(FATAL_ERROR "Missing srcWorker anchor")
endif()
string(SUBSTRING "${original}" 0 ${split} capture)
string(SUBSTRING "${original}" ${split} -1 worker)
string(REPLACE "ProAudioThreadScope captureRealtime;" "ProAudioThreadScope captureRealtime; src_trace::captureProAudioActive=captureRealtime.active(); src_trace::captureFailureReason=captureRealtime.failureReason();" capture "${capture}")
string(REPLACE "while(!stop_.load(std::memory_order_acquire)) {" "src_trace::WorkerScope workerScope;\n    while(!stop_.load(std::memory_order_acquire)) {\n        src_trace::Iteration traceIteration(*this);" worker "${worker}")
if(worker MATCHES "ProAudioThreadScope workerRealtime;")
 string(REPLACE "src_trace::WorkerScope workerScope;" "src_trace::workerProAudioActive=workerRealtime.active(); src_trace::workerFailureReason=workerRealtime.failureReason(); src_trace::workerPriority=GetThreadPriority(GetCurrentThread());" worker "${worker}")
endif()
foreach(branch RANGE 1 3)
 if(branch LESS 3 AND worker MATCHES "wake_\\.waitForChange")
  set(anchor "wake_.waitForChange(wakeRevision)")
  set(replacement "src_trace::sleepCall(${branch},[&]{ return (wake_.waitForChange)(wakeRevision); })")
 else()
  set(anchor "std::this_thread::sleep_for(std::chrono::milliseconds(1))")
  set(replacement "src_trace::sleepCall(${branch},[&]{ std::this_thread::sleep_for(std::chrono::milliseconds(1)); })")
 endif()
 string(FIND "${worker}" "${anchor}" pos)
 if(pos LESS 0)
  message(FATAL_ERROR "Missing trace wait branch ${branch}")
 endif()
 string(SUBSTRING "${worker}" 0 ${pos} before)
 string(LENGTH "${anchor}" len)
 math(EXPR afterPos "${pos}+${len}")
 string(SUBSTRING "${worker}" ${afterPos} -1 after)
 set(worker "${before}${replacement}${after}")
endforeach()
string(REPLACE "sa.process(src_->handle(),&sb)" "src_trace::process([&]{ return sa.process(src_->handle(),&sb); },sb)" worker "${worker}")
file(WRITE "${OUTPUT}" "#include <entropy/src_abi.h>\n#include \"SrcWorkerTrace.h\"\n${capture}${worker}")
