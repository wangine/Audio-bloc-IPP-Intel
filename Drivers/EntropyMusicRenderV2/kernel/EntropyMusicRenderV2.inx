[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=10/15/2026,0.3.1.0
CatalogFile=EntropyMusicRenderV2.cat
PnpLockDown=1

[SourceDisksNames]
1=%DiskName%
[SourceDisksFiles]
EntropyMusicRenderV2.sys=1
[DestinationDirs]
Music.Copy=13
[Manufacturer]
%ProviderName%=MusicModels,NT$ARCH$.10.0...22000
[MusicModels.NT$ARCH$.10.0...22000]
%DeviceName%=Music,ROOT\EntropyMusicRenderV2
[Music.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=Music.Copy
AddReg=Music.AddReg
[Music.Copy]
EntropyMusicRenderV2.sys
[Music.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,EntropyMusicRenderV2.sys
HKR,Drivers,SubClasses,,"wave"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
[Music.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%WaveName%,Music.Wave
AddInterface=%KSCATEGORY_RENDER%,%WaveName%,Music.Wave
AddInterface=%KSCATEGORY_REALTIME%,%WaveName%,Music.Wave
AddInterface=%KSCATEGORY_AUDIO%,%TopologyName%,Music.Topology
AddInterface=%KSCATEGORY_TOPOLOGY%,%TopologyName%,Music.Topology
[Music.Wave]
AddReg=Music.Wave.AddReg
[Music.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DeviceName%
[Music.Topology]
AddReg=Music.Topology.AddReg
[Music.Topology.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DeviceName%
HKR,EP\0,%Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%EventDriven%,0x00010001,1
[Music.NT.Services]
AddService=EntropyMusicRenderV2,0x00000002,Music.Service
[Music.Service]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\EntropyMusicRenderV2.sys
[Music.NT.HW]
AddReg=Music.Security
[Music.Security]
HKR,,DeviceType,0x10001,0x1d
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"
[Music.NT.Wdf]
KmdfService=EntropyMusicRenderV2,Music.Wdf
[Music.Wdf]
KmdfLibraryVersion=$KMDFVERSION$
