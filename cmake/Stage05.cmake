string(REPLACE "entropy_module_get_api" "entropy_storage_control_get_api" STAGE05_ORIGINAL_CONTROL "${STAGE05_ORIGINAL_CONTROL}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/OriginalCrossoverControl.inc" "${STAGE05_ORIGINAL_CONTROL}")
