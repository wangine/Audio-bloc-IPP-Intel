# Original vendor sources are extracted locally from the same pinned native commit.
enable_language(C)
set(STAGE04_REFERENCE "${CMAKE_CURRENT_SOURCE_DIR}/local/stage04-ref/Stage3/native-reference" CACHE PATH "Pinned native egress references")
set(SRC_ROOT "${STAGE04_REFERENCE}/dependencies/SRC")
if(NOT EXISTS "${SRC_ROOT}/R8Brain/src/r8brain-free-src/CDSPResampler.h")
    message(FATAL_ERROR "Missing original SRC build dependencies: run tools/Stage04-References.ps1")
endif()
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(WITH_OPENMP OFF CACHE BOOL "" FORCE)
set(WITH_LSR_BINDINGS OFF CACHE BOOL "" FORCE)
add_subdirectory("${SRC_ROOT}/SoXR/src/soxr" "${CMAKE_BINARY_DIR}/soxr" EXCLUDE_FROM_ALL)
add_library(entropy_nominal_wire STATIC "${SRC_ROOT}/src/MultiChannelSrcEngine.cpp")
target_include_directories(entropy_nominal_wire PUBLIC "${SRC_ROOT}/include")
target_link_libraries(entropy_nominal_wire PUBLIC entropy_abi soxr)
entropy_native_flags(entropy_nominal_wire)
add_library(entropy_clocksync STATIC
    Egress/ClockSync/src/EgressClockEngine.cpp
    Egress/ClockSync/src/EgressClockEstimator.cpp
    Egress/ClockSync/src/EgressRatioController.cpp)
target_include_directories(entropy_clocksync PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/Egress/ClockSync/include")
target_link_libraries(entropy_clocksync PUBLIC entropy_nominal_wire entropy_abi)
entropy_native_flags(entropy_clocksync)
add_library(entropy_wasapi STATIC Egress/WasapiSink/src/WasapiDacSink.cpp Egress/WasapiSink/src/DacSinkCore.cpp)
target_include_directories(entropy_wasapi PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/Egress/WasapiSink/include")
target_link_libraries(entropy_wasapi PUBLIC entropy_abi ole32 uuid propsys)
entropy_native_flags(entropy_wasapi)
add_library(entropy_devices STATIC Devices/DeviceManager/src/WindowsDeviceInventory.cpp Devices/DeviceManager/src/DeviceIdentityResolver.cpp)
target_include_directories(entropy_devices PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/Devices/DeviceManager/include")
target_link_libraries(entropy_devices PUBLIC entropy_abi ole32 uuid propsys cfgmgr32)
entropy_native_flags(entropy_devices)
add_library(entropy_egress STATIC Engine/Egress/NativeEgress.cpp)
target_include_directories(entropy_egress PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}")
target_link_libraries(entropy_egress PUBLIC entropy_graph entropy_clocksync entropy_pcm24)
entropy_native_flags(entropy_egress)
target_link_libraries(EntropyAudioCore PRIVATE entropy_egress entropy_wasapi entropy_devices)
target_sources(EntropyAudioCore PRIVATE Engine/Egress/HardwareTest.cpp)
target_link_libraries(EntropyAudioCore PRIVATE bcrypt)
target_compile_definitions(EntropyAudioCore PRIVATE ENTROPY_STAGE04_EGRESS=1)
if(BUILD_TESTING)
    add_executable(EntropyStage04HardwareGate Tests/Stage04HardwareGateTests.cpp Engine/Egress/HardwareTest.cpp)
    target_link_libraries(EntropyStage04HardwareGate PRIVATE entropy_egress entropy_wasapi entropy_devices bcrypt)
    entropy_native_flags(EntropyStage04HardwareGate)
    add_test(NAME EntropyStage04HardwareGate COMMAND EntropyStage04HardwareGate "${CMAKE_BINARY_DIR}/stage04-gate-tests")
    add_executable(EntropyStage04Validation Tests/Stage04Validation.cpp
        Tests/Stage02/RealtimeAllocationAudit.cpp Tests/Stage02/AuditExtras.cpp)
    target_link_libraries(EntropyStage04Validation PRIVATE entropy_egress)
    entropy_native_flags(EntropyStage04Validation)
    add_test(NAME EntropyStage04Offline COMMAND EntropyStage04Validation "${CMAKE_BINARY_DIR}/stage04-results")
endif()
