# Explicit opt-in. This reads only the immutable reference and runs offline DSP.
option(ENTROPY_V07_INTEGRATION "Build strict offline native/V07 Crossover oracle" OFF)
if(ENTROPY_V07_INTEGRATION)
    if(NOT BUILD_TESTING)
        message(FATAL_ERROR "V07 integration requires BUILD_TESTING")
    endif()
    set(ENTROPY_V07_DLL "D:/Projects/Stage3-Crossover-V07-RUNTIME-20261008/modules/EntropyCrossover.dll" CACHE FILEPATH "Published immutable V07 reference DLL")
    if(NOT EXISTS "${ENTROPY_V07_DLL}")
        message(FATAL_ERROR "Verified V07 reference DLL missing: ${ENTROPY_V07_DLL}")
    endif()
    file(SHA256 "${ENTROPY_V07_DLL}" V07_REFERENCE_SHA256)
    if(NOT V07_REFERENCE_SHA256 STREQUAL "1b0f76bf38f2e387945cf16a8de38b1ae8fa25a9a9af2ac976473671d0a7889a")
        message(FATAL_ERROR "V07 reference SHA256 mismatch: ${V07_REFERENCE_SHA256}")
    endif()
    add_executable(EntropyV07Integration Tests/V07CrossoverIntegration.cpp)
    target_include_directories(EntropyV07Integration PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
    target_link_libraries(EntropyV07Integration PRIVATE entropy_crossover bcrypt crypt32)
    entropy_native_flags(EntropyV07Integration)
    add_test(NAME EntropyV07Integration COMMAND EntropyV07Integration "${ENTROPY_V07_DLL}" "${CMAKE_BINARY_DIR}/v07-integration-results")
    set_tests_properties(EntropyV07Integration PROPERTIES TIMEOUT 180)
endif()
